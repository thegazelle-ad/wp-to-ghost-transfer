	<item>
		<title>Entrepreneurial Week gets students thinking about start-ups </title>
		<link>http://localhost/?p=72871</link>
		<pubDate>Sat, 18 Oct 2014 21:58:08 +0000</pubDate>
		<dc:creator><![CDATA[Tanya Bansal]]></dc:creator>
