	<item>
		<title>TGTV: Perspectives on U.S. Culture at NYUAD</title>
		<link>http://localhost/?p=25561</link>
		<pubDate>Sun, 10 Nov 2013 13:45:41 +0000</pubDate>
		<dc:creator><![CDATA[TGTV]]></dc:creator>
