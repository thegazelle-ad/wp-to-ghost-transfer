		<title>Google’s University Outreach Coordinator for MENA Speaks at NYUAD</title>
		<link>http://localhost/?p=69411</link>
		<pubDate>Sat, 20 Sep 2014 21:47:28 +0000</pubDate>
		<dc:creator><![CDATA[Asyrique Asyraf Thevendran]]></dc:creator>
