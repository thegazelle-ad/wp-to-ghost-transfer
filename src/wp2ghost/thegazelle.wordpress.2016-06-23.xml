	<item>
		<title>Keeping Up Appearances</title>
		<link>http://localhost/?p=69351</link>
		<pubDate>Sat, 20 Sep 2014 22:04:22 +0000</pubDate>
		<dc:creator><![CDATA[Grega Ulen]]></dc:creator>
		<guid isPermaLink="false">http://www.thegazelle.org/?p=69351</guid>
		<description></description>
		<content:encoded><![CDATA[<style>
