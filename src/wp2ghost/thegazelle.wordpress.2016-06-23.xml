	<item>
		<title>From the Square: Proposed bill plans paid state tuition</title>
		<link>http://localhost/?p=47801</link>
		<pubDate>Sun, 09 Mar 2014 00:30:48 +0000</pubDate>
		<dc:creator><![CDATA[Ann Schmidt]]></dc:creator>
