	<item>
		<title>Students explore, study beyond the GNU</title>
		<link>http://localhost/?p=1551</link>
		<pubDate>Sat, 20 Apr 2013 22:00:00 +0000</pubDate>
		<dc:creator><![CDATA[Clare Hennig]]></dc:creator>
