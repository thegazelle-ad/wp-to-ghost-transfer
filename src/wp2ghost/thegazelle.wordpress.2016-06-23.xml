	<item>
		<title>Take The Bloody Tax Off Tampons</title>
		<link>http://localhost/?p=139561</link>
		<pubDate>Sat, 31 Oct 2015 14:42:18 +0000</pubDate>
		<dc:creator><![CDATA[Liza]]></dc:creator>
