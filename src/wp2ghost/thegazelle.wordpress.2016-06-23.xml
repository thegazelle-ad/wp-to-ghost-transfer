		<title>Artist: Sarah Bushra</title>
		<link>http://localhost/?p=109541</link>
		<pubDate>Sat, 18 Apr 2015 14:16:47 +0000</pubDate>
		<dc:creator><![CDATA[Laura Waltje]]></dc:creator>
