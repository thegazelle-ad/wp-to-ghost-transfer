		<title>Fixing the market on the road to an alternative energy future</title>
		<link>http://localhost/?p=56561</link>
		<pubDate>Sun, 27 Apr 2014 00:28:23 +0000</pubDate>
		<dc:creator><![CDATA[Jacob Hartwig]]></dc:creator>
