	<item>
		<title>Tennis Courts, Convenience Store and Pool set to open</title>
		<link>http://localhost/?p=75341</link>
		<pubDate>Tue, 28 Oct 2014 19:20:59 +0000</pubDate>
		<dc:creator><![CDATA[Sebastian Rojas Cabal]]></dc:creator>
		<guid isPermaLink="false">http://www.thegazelle.org/?p=75341</guid>
		<description></description>
		<content:encoded><![CDATA[<style type="text/css">
#pano{
    margin-left: -5.5%;
    width: 111%;
    height: 242px;
}

@media screen and (min-width: 520px){
