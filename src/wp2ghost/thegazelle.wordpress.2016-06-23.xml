		<title>A Playlist: Arab Culture Night</title>
		<link>http://localhost/?p=107411</link>
		<pubDate>Sat, 11 Apr 2015 20:40:30 +0000</pubDate>
		<dc:creator><![CDATA[Sala Shaker]]></dc:creator>
		<guid isPermaLink="false">http://www.thegazelle.org/?p=107411</guid>
