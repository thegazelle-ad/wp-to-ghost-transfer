		<title>BREAKING: CLASS REPRESENTATIVES ELECTION RESULTS</title>
		<link>http://localhost/?p=70721</link>
		<pubDate>Tue, 23 Sep 2014 20:38:17 +0000</pubDate>
		<dc:creator><![CDATA[Andres Rodriguezz]]></dc:creator>
